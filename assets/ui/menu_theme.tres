[gd_resource type="Theme" load_steps=12 format=3]

; Tema verde "terminal hacker" usado só no menu principal (MainMenu.tscn).
; O resto do jogo continua com assets/ui/cyber_theme.tres (ciano).
; Para usar uma fonte própria (ex.: Share Tech Mono), coloque o .ttf em
; assets/ui/fonts/ e troque "Default Font" aqui no Inspetor.

[sub_resource type="SystemFont" id="Mono"]
font_names = PackedStringArray("Share Tech Mono", "JetBrains Mono", "Cascadia Mono", "Consolas", "DejaVu Sans Mono", "Liberation Mono", "Menlo", "Monospace")
font_weight = 500
antialiasing = 1
subpixel_positioning = 0

[sub_resource type="FontVariation" id="MonoSpaced"]
base_font = SubResource("Mono")
spacing_glyph = 1

[sub_resource type="SystemFont" id="MonoBold"]
font_names = PackedStringArray("Share Tech Mono", "JetBrains Mono", "Cascadia Mono", "Consolas", "DejaVu Sans Mono", "Liberation Mono", "Menlo", "Monospace")
font_weight = 800
antialiasing = 1
subpixel_positioning = 0

[sub_resource type="FontVariation" id="TitleFont"]
base_font = SubResource("MonoBold")
spacing_glyph = 10

; --- Painéis (Opções / Controles): fundo escuro, borda verde, cantos chanfrados ---
[sub_resource type="StyleBoxFlat" id="PanelGreen"]
bg_color = Color(0, 0.05, 0.02, 0.9)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 0.9, 0.45, 0.85)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
corner_detail = 1
shadow_color = Color(0.1, 1, 0.4, 0.3)
shadow_size = 12
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="BtnNormal"]
bg_color = Color(0, 0.06, 0.02, 0.72)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.12, 0.65, 0.3, 0.85)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
corner_detail = 1
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="BtnHover"]
bg_color = Color(0.02, 0.2, 0.08, 0.78)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 1, 0.55, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
corner_detail = 1
shadow_color = Color(0.2, 1, 0.45, 0.45)
shadow_size = 10
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="BtnPressed"]
bg_color = Color(0.1, 0.5, 0.2, 0.9)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.8, 1, 0.85, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
corner_detail = 1
shadow_color = Color(0.3, 1, 0.5, 0.5)
shadow_size = 12
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0

; Foco (teclado / botão selecionado): só contorno brilhante, sem preencher
[sub_resource type="StyleBoxFlat" id="BtnFocus"]
draw_center = false
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 1, 0.55, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
corner_detail = 1
shadow_color = Color(0.2, 1, 0.45, 0.5)
shadow_size = 12

[sub_resource type="StyleBoxFlat" id="SliderTrack"]
bg_color = Color(0, 0.05, 0.02, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.2, 0.9, 0.45, 0.5)
content_margin_top = 4.0
content_margin_bottom = 4.0

[sub_resource type="StyleBoxFlat" id="SliderFill"]
bg_color = Color(0.25, 1, 0.5, 0.9)
content_margin_top = 4.0
content_margin_bottom = 4.0

[resource]
default_font = SubResource("MonoSpaced")
default_font_size = 17

Panel/styles/panel = SubResource("PanelGreen")

InnerPanel/base_type = &"Panel"
InnerPanel/styles/panel = SubResource("PanelGreen")

; ---------- Textos ----------
Label/colors/font_color = Color(0.72, 1, 0.8, 1)
Label/colors/font_shadow_color = Color(0, 0.1, 0.03, 0.85)
Label/constants/shadow_offset_x = 1
Label/constants/shadow_offset_y = 1
Label/constants/line_spacing = 3

; Título grande "CYBER CITY": menta claro com brilho verde
TitleLabel/base_type = &"Label"
TitleLabel/fonts/font = SubResource("TitleFont")
TitleLabel/font_sizes/font_size = 76
TitleLabel/colors/font_color = Color(0.78, 1, 0.84, 1)
TitleLabel/colors/font_outline_color = Color(0.05, 0.6, 0.22, 0.85)
TitleLabel/colors/font_shadow_color = Color(0, 1, 0.75, 0.5)
TitleLabel/constants/outline_size = 5
TitleLabel/constants/shadow_offset_x = 4
TitleLabel/constants/shadow_offset_y = 0

SubtitleLabel/base_type = &"Label"
SubtitleLabel/font_sizes/font_size = 20
SubtitleLabel/colors/font_color = Color(0.4, 0.95, 0.58, 1)

HeadingLabel/base_type = &"Label"
HeadingLabel/font_sizes/font_size = 24
HeadingLabel/colors/font_color = Color(0.4, 1, 0.6, 1)
HeadingLabel/colors/font_shadow_color = Color(0, 0.4, 0.15, 0.8)
HeadingLabel/constants/shadow_offset_x = 2
HeadingLabel/constants/shadow_offset_y = 2

DimLabel/base_type = &"Label"
DimLabel/font_sizes/font_size = 13
DimLabel/colors/font_color = Color(0.4, 0.7, 0.5, 1)

; ---------- Botões ----------
Button/colors/font_color = Color(0.75, 1, 0.82, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/colors/font_focus_color = Color(1, 1, 1, 1)
Button/colors/font_disabled_color = Color(0.35, 0.5, 0.4, 1)
Button/styles/normal = SubResource("BtnNormal")
Button/styles/hover = SubResource("BtnHover")
Button/styles/pressed = SubResource("BtnPressed")
Button/styles/disabled = SubResource("BtnNormal")
Button/styles/focus = SubResource("BtnFocus")

CheckButton/colors/font_color = Color(0.75, 1, 0.82, 1)
CheckButton/colors/font_hover_color = Color(1, 1, 1, 1)
CheckButton/styles/normal = SubResource("BtnNormal")
CheckButton/styles/hover = SubResource("BtnHover")
CheckButton/styles/pressed = SubResource("BtnNormal")
CheckButton/styles/hover_pressed = SubResource("BtnHover")
CheckButton/styles/focus = SubResource("BtnFocus")

HSlider/styles/slider = SubResource("SliderTrack")
HSlider/styles/grabber_area = SubResource("SliderFill")
HSlider/styles/grabber_area_highlight = SubResource("SliderFill")
